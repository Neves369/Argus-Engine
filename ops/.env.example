# Template de variáveis para ops/argus.sh (produção). Copie para ops/.env e
# preencha — ops/.env não é versionado (padrão `.env` do .gitignore).
#
#   cp ops/.env.example ops/.env && $EDITOR ops/.env

# Obrigatórias (deploy de produção)
GHCR_OWNER=seu-usuario-ou-org
TAG=1.2.3
DOMAIN=argus.exemplo.com
ACME_EMAIL=ops@exemplo.com
UI_PASSWORD='senha-forte-do-operador'

# Obrigatória quando o monitoring sobe junto (padrão do `up`)
GRAFANA_ADMIN_PASSWORD='senha-do-grafana'

# Recomendado: sessões sobrevivem à rotação de senha.
# Gere com: openssl rand -hex 32
# ARGUS_SESSION_SECRET=

# Segredos do backend continuam em backend/.env (env_file do serviço).

# Modo dev (argus.sh dev) não usa estas variáveis; login do Grafana default é
# admin/admin a menos que GRAFANA_ADMIN_PASSWORD seja exportado.