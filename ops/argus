#!/usr/bin/env bash
#
# argus — Argus Engine local "on-demand" (estilo VM: só sobe quando precisa
# e derruba o Docker quando termina).
#
#   argus [up|down|status|toggle|launch]
#
# Sobe a stack do app (projeto argus-app, docker-compose.yml) e cuida do
# dockerd (start/stop) + abertura da UI no browser. Não mexe no monitoring
# nem no ops/argus.sh.
#
# "launch" abre a UI em uma janela dedicada (chromium --app) estilo VM:
# a janela aberta marca a posse; ao fechá-la o stack é derrubado.

set -euo pipefail

SELF="$(readlink -f "$0")"
ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
COMPOSE="$ROOT/docker-compose.yml"
PROJECT="argus-app"
URL="http://localhost:8080"
LOG="/tmp/argus.log"
LAUNCH_OWNERSHIP="/tmp/argus-launch-owns"
LAUNCH_PROFILE="$HOME/.local/share/argus/chromium"

COMPOSE_CMD=(docker compose -p "$PROJECT" -f "$COMPOSE")

log()  { printf '\033[1;36m[argus]\033[0m %s\n' "$*" | tee -a "$LOG"; }
warn() { printf '\033[1;33m[argus]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[argus]\033[0m %s\n' "$*" >&2; notify "Argus" "Erro: $*" || true; exit 1; }
notify() { command -v notify-send >/dev/null 2>&1 && notify-send "$@"; }

# dockerd ativo? (socket responde)
daemon_active() { systemctl is-active docker >/dev/null 2>&1; }

# stack argus do app (projeto argus-app, containers argus-app-backend-1/
# argus-app-frontend-1) no ar? não confundir com o monitoring do projeto
# `argus` (argus-grafana-1, argus-prometheus-1, argus-alertmanager-1).
stack_up() { docker ps --format '{{.Names}}' 2>/dev/null | grep -qE '^argus-app-(backend|frontend)-'; }

# Eleva systemctl: sudo se há TTY, pkexec se vindo de fluxos gráficos (menu). 
daemon() {
  local action="$1" cmd=(systemctl "$action" docker)
  if [[ -t 0 ]]; then
    sudo "${cmd[@]}"
  else
    pkexec "${cmd[@]}"
  fi
}

do_up() {
  rm -f "$LAUNCH_OWNERSHIP"
  [[ -f "$LOG" ]] && : > "$LOG"
  if stack_up; then
    notify "Argus" "Já está no ar: $URL" || true
    log "já está no ar: $URL"
    exit 0
  fi
  if ! daemon_active; then
    log "dockerd parado — iniciando…"
    daemon start
  fi
  log "subindo stack (build na primeira vez)…"
  ( cd "$ROOT" && "${COMPOSE_CMD[@]}" up -d --build ) 2>&1 | tee -a "$LOG" || die "falha no 'docker compose up' (veja $LOG)"
  log "aguardando UI…"
  local i
  for ((i = 0; i < 120; i++)); do
    curl -fsS -o /dev/null --max-time 2 "$URL" 2>/dev/null && break
    sleep 1
  done
  curl -fsS -o /dev/null --max-time 2 "$URL" || die "stack subiu mas a UI ($URL) não respondeu (veja $LOG)"
  log "no ar em $URL, abrindo browser…"
  omarchy-launch-browser "$URL" 2>/dev/null || xdg-open "$URL" 2>/dev/null || true
  notify "Argus" "No ar: $URL" || true
}

do_down() {
  if ! daemon_active && ! stack_up; then
    warn "dockerd e stack já estão parados."
    exit 0
  fi
  if stack_up; then
    log "derrubando stack…"
    ( cd "$ROOT" && "${COMPOSE_CMD[@]}" down ) 2>&1 | tee -a "$LOG" || die "falha no 'docker compose down' (veja $LOG)"
  fi
  log "parando dockerd…"
  daemon stop
  rm -f "$LAUNCH_OWNERSHIP"
  notify "Argus" "Stack parado e dockerd desligado." || true
  log "pronto. O monitoring (projeto \`argus\`) volta sozinho no próximo 'argus up'."
}

# Navegador default (xdg-settings → Exec da .desktop), com fallback comum.
detect_browser() {
  local desktop exec_line binary
  desktop="$(xdg-settings get default-web-browser 2>/dev/null || true)"
  desktop="${desktop%.desktop}"
  if [[ -n "$desktop" ]]; then
    exec_line="$(grep -m1 -h '^Exec=' "$HOME/.local/share/applications/$desktop.desktop" "/usr/share/applications/$desktop.desktop" 2>/dev/null | head -1)"
  fi
  binary="$(printf '%s' "${exec_line#Exec=}" | awk '{print $1}')"
  binary="${binary%\%}"
  if [[ -n "$binary" ]] && command -v "$binary" >/dev/null 2>&1; then
    printf '%s\n' "$binary"
    return
  fi
  if [[ -n "$binary" ]] && [[ -x "$binary" ]]; then
    printf '%s\n' "$binary"
    return
  fi
  for b in chromium google-chrome brave firefox; do
    if command -v "$b" >/dev/null 2>&1; then
      printf '%s\n' "$b"
      return
    fi
  done
  die "não encontrei um navegador para a janela dedicada."
}

do_launch() {
  rm -f "$LAUNCH_OWNERSHIP"
  local owns=false

  if ! daemon_active; then
    log "dockerd parado — iniciando…"
    daemon start
  fi

  if ! stack_up; then
    owns=true
    log "subindo stack (build na primeira vez)…"
    ( cd "$ROOT" && "${COMPOSE_CMD[@]}" up -d --build ) 2>&1 | tee -a "$LOG" || die "falha no 'docker compose up' (veja $LOG)"
    log "aguardando UI…"
    local i
    for ((i = 0; i < 120; i++)); do
      curl -fsS -o /dev/null --max-time 2 "$URL" 2>/dev/null && break
      sleep 1
    done
    curl -fsS -o /dev/null --max-time 2 "$URL" || die "stack subiu mas a UI ($URL) não respondeu (veja $LOG)"
    : > "$LAUNCH_OWNERSHIP"
  fi

  local browser pid
  browser="$(detect_browser)"
  mkdir -p "$LAUNCH_PROFILE"
  log "abrindo janela dedicada ($browser) — feche a janela para desligar o stack…"
  "$browser" --user-data-dir="$LAUNCH_PROFILE" --app="$URL" >/dev/null 2>&1 &
  pid=$!
  wait "$pid" 2>/dev/null || true

  if [[ -f "$LAUNCH_OWNERSHIP" ]]; then
    rm -f "$LAUNCH_OWNERSHIP"
    log "janela fechada — derrubando stack…"
    ( cd "$ROOT" && "${COMPOSE_CMD[@]}" down ) 2>&1 | tee -a "$LOG" || die "falha no 'docker compose down' (veja $LOG)"
    notify "Argus" "Janela fechada — stack Argus parado." || true
    log "stack parado (dockerd permanece ativo)."
  else
    notify "Argus" "Janela fechada — stack segue no ar." || true
    log "stack não foi iniciado por esta sessão — mantendo no ar."
  fi
}

do_status() {
  if ! daemon_active; then
    echo "  dockerd: parado — stack não está no ar"
    exit 0
  fi
  if ! stack_up; then
    echo "  dockerd: ativo — stack Argus parado (use 'argus up')"
    exit 0
  fi
  ( cd "$ROOT" && "${COMPOSE_CMD[@]}" ps ) || true
  local code
  code=$(curl -sSo /dev/null -w '%{http_code}' --max-time 5 "$URL" 2>/dev/null || echo 000)
  printf '  %-16s %s (HTTP %s)\n' "dev UI" "$URL" "$code"
}

usage() {
  cat <<'EOF'
Uso: argus [up|down|status|toggle|launch]

  up       garante o dockerd, sobe a stack (compose dev, sem monitoring),
           espera a UI e abre http://localhost:8080 no browser
  down     derruba a stack e desliga o dockerd (dados ficam em ./data)
  status   mostra dockerd + stack + probes de saúde
  toggle   no ar -> down; parado -> up (para o ícone do menu de apps)
  launch   abre a UI em janela dedicada estilo VM; ao fechar a janela
           derruba a stack (dockerd permanece ativo)
EOF
  exit 0
}

main() {
  local cmd="${1:-help}"
  case "$cmd" in
    help|-h|--help) usage ;;
    up) do_up ;;
    down) do_down ;;
    status) do_status ;;
    launch) do_launch ;;
    toggle)
      if stack_up; then
        do_down
      else
        do_up
      fi
      ;;
    *) die "comando desconhecido: $cmd (use 'argus help')" ;;
  esac
}

main "$@"