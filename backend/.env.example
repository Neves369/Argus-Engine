# Argus Engine - configuração do backend
# Copie para .env e ajuste conforme necessário.

# Banco de dados (SQLite local por padrão)
DATABASE_URL=sqlite+aiosqlite:///./data/argus.db

# Prefixo da API
API_PREFIX=/api/v1

# Logging
LOG_LEVEL=INFO
DEBUG=false

# Escopo autorizado (JSON). Somente alvos dentro destes domínios serão aceitos.
# Ex.: ALLOWED_SCOPES=["example.com","staging.example.com"]
ALLOWED_SCOPES=[]

# Kill-switch operacional: se true, nenhum run é iniciado.
KILL_SWITCH=false

# Orçamentos padrão por run
DEFAULT_BUDGET_TOKENS=100000
DEFAULT_BUDGET_COST=1.0

# Limiar de confiança para encerrar o grafo
CONFIDENCE_THRESHOLD=0.6
# Execução paralela básica (Etapa 1): pernas independentes de um nó (gateway +
# fontes + scan) rodam em concorrência. Desligar para depurar latência/custos.
# AGENT_PARALLEL=true

# Filtro de Qualidade (Etapa 6)
# FP_BLACKLIST: seed imutável de falsos positivos conhecidos (JSON de strings,
# substring match sobre título+descrição). Regras aprendidas de decisões
# humanas são persistidas em `fp_rules` e mescladas com este seed na validação.
# FP_BLACKLIST=["público","noise"]
# FP_LEARNING: aprende automaticamente uma regra ao marcar um finding como
# `false_positive` (PATCH /findings/{id}). Regras ficam gerenciáveis em
# GET/POST/PATCH/DELETE /findings/fp-rules.
FP_LEARNING=true
# QUALITY_SCORE_THRESHOLD=0.6

# LLM Gateway (Etapa 3) — chaves de API (nunca commitadas)
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Modelos por modo (JSON de combos "provider/model", em ordem de prioridade)
# execution = modelos sem restrição (usados quando DEVIL_MODE=true)
# judgment  = modelos fixos/restritos (julgamento/investigação)
EXECUTION_MODELS=["groq/llama-3.3-70b-versatile","openrouter/openrouter/auto"]
JUDGMENT_MODELS=["groq/llama-3.1-8b-instant","openai/gpt-4o-mini"]

# Estratégia de ordenação do pool: priority | fallback | cost-optimized | auto
# priority/fallback  = ordem declarada acima
# cost-optimized     = mais barato primeiro (price_in + price_out)
# auto               = cost-optimized para julgamento, priority para execução
LLM_STRATEGY=priority

# Cache de prefixo: serve completions idênticas (mesmo provider+model+mensagens)
# da memória em vez de chamar o provider de novo.
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_SECONDS=300

# Compressão de prompt: normaliza espaços em branco (sempre) e corta mensagens
# muito longas mantendo início/fim. 0 desliga o corte por tamanho.
LLM_MAX_PROMPT_CHARS=8000

# Hardening (Etapa 10): limites de recurso aplicados a todo subprocesso de tool
# CLI. POSIX only (no-op no Windows). Ver docs/RUNBOOK.md §6.
TOOL_SUBPROCESS_MEMORY_LIMIT_MB=512
TOOL_SUBPROCESS_MAX_OUTPUT_BYTES=65536

# Sandbox de tools (Etapa 5, ver docs/adr/0007-tool-sandbox.md): executa tools
# CLI em container Docker descartável em vez de subprocesso direto.
# Opt-in (default false). Quando habilitado e o Docker estiver indisponível,
# a tool NÃO roda (fail-closed) — nunca cai silenciosamente para subprocesso.
# TOOL_SANDBOX=true
# TOOL_SANDBOX_IMAGE=alpine:latest
# TOOL_SANDBOX_CPUS=1.0
# TOOL_SANDBOX_PIDS_LIMIT=64
# TOOL_SANDBOX_UID=65534

# Scanning ativo (Etapa 12) — controles obrigatórios (ver docs/adr/0006-active-scanning.md).
# Rate limit de requisições ao alvo POR MINUTO.
SCAN_RATE_LIMIT=10
# Timeout por requisição ao alvo (segundos).
SCAN_REQUEST_TIMEOUT=10
# Máximo de páginas crawleadas por scan.
SCAN_MAX_PAGES=10
# Teto de bytes do corpo de cada resposta.
SCAN_MAX_BODY_BYTES=512000
# Respeitar robots.txt (self-imposed restriction) — true por padrão.
SCAN_RESPECT_ROBOTS=true
# User-Agent enviado ao alvo.
SCAN_USER_AGENT=ArgusEngine/0.1 (authorized scanning)
# Auth estática do scan (slice 1 de "login + scan"): headers extras em JSON e
# cookies de sessão aplicados a todo request ao alvo. Vazios por padrão.
# SCAN_EXTRA_HEADERS={"Authorization":"Bearer ..."}
# SCAN_COOKIES=session=abc123; theme=dark
# Login dinâmico (slice 2 de "login + scan"): o scanner submete o form de login
# do alvo e reutiliza a sessão nos demais requests. Vazio = desligado.
# SCAN_LOGIN_URL=https://example.com/login
# SCAN_LOGIN_USERNAME=operator
# SCAN_LOGIN_PASSWORD=

# Origens CORS permitidas (JSON)
CORS_ORIGINS=["http://localhost:5173"]

# Chave de criptografia para chaves de API (Fernet). Gere com: Fernet.generate_key()
# Nunca commitada — definir no ambiente de produção.
ARGUS_ENCRYPTION_KEY=

# Fontes de pesquisa (sources.json) — chaves opcionais. Sem elas, cada fonte
# ainda funciona no que a API permite anonimamente (ou degrada para resultado
# simulado, como o resto do sistema já faz sem chave de LLM).
# NVD (NIST): sem chave = 5 req/30s; com chave = 50 req/30s.
NVD_API_KEY=
# AbuseIPDB: obrigatória — sem ela toda consulta falha e cai no fallback simulado.
ABUSEIPDB_API_KEY=
# urlscan.io: opcional — sem ela, a busca funciona com cota menor (anônima).
URLSCAN_API_KEY=

# Correlação de CVE (Etapa 13, ver docs/adr/0008-cve-correlation.md): máximo de
# CVEs por produto/versão retornados do NVD para um mesmo banner correlacionado.
# CISA KEV e CVE.report não exigem chave. Sem dado real a correlação não gera
# finding (degradação silenciosa).
# CVE_CORRELATE_MAX_CVES=5

# Economia de tokens (Etapa 7) — todos DESLIGADOS por padrão, opt-in.
# Caveman: remove palavras de enchimento das mensagens enviadas aos providers.
CAVEMAN_PROMPTS=false
# Compressão de histórico entre nós do grafo: mantém o primeiro + últimos N
# registros, descarta o meio (determinístico, sem chamada de LLM).
HISTORY_COMPRESSION=false
HISTORY_KEEP_LAST=8
# Compactação de saída de tools ("RTK ou equivalente"): remove campos nulos/
# vazios e minifica JSON antes de armazenar/retornar o resultado de uma tool.
TOOL_OUTPUT_COMPRESSION=false
# Orçamento hard por agente (0 = desligado), além do orçamento do run inteiro.
# Só relevante para arquétipos que repetem (Eremita/Carro no modo padrão).
BUDGET_TOKENS_PER_AGENT=0
BUDGET_COST_PER_AGENT=0.0
