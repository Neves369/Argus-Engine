# Argus Engine - configuração do backend
# Copie para .env e ajuste conforme necessário.

# Banco de dados (SQLite local por padrão)
DATABASE_URL=sqlite+aiosqlite:///./data/argus.db

# Prefixo da API
API_PREFIX=/api/v1

# Logging
LOG_LEVEL=INFO
DEBUG=false

# Escopo autorizado (JSON). Somente alvos dentro destes domínios serão aceitos.
# Ex.: ALLOWED_SCOPES=["example.com","staging.example.com"]
ALLOWED_SCOPES=[]

# Kill-switch operacional: se true, nenhum run é iniciado.
KILL_SWITCH=false

# Orçamentos padrão por run
DEFAULT_BUDGET_TOKENS=100000
DEFAULT_BUDGET_COST=1.0

# Limiar de confiança para encerrar o grafo
CONFIDENCE_THRESHOLD=0.6

# Origens CORS permitidas (JSON)
CORS_ORIGINS=["http://localhost:5173"]
