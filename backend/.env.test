# Argus Engine - configuração do backend
# Copie para .env e ajuste conforme necessário.

# Banco de dados (SQLite local por padrão)
DATABASE_URL=sqlite+aiosqlite:///./data/argus.db

# Prefixo da API
API_PREFIX=/api/v1

# Logging
LOG_LEVEL=INFO
DEBUG=false

# Escopo autorizado (JSON). Somente alvos dentro destes domínios serão aceitos.
# Ex.: ALLOWED_SCOPES=["example.com","staging.example.com"]
ALLOWED_SCOPES=[]

# Kill-switch operacional: se true, nenhum run é iniciado.
KILL_SWITCH=false

# Orçamentos padrão por run
DEFAULT_BUDGET_TOKENS=100000
DEFAULT_BUDGET_COST=1.0

# Limiar de confiança para encerrar o grafo
CONFIDENCE_THRESHOLD=0.6

# LLM Gateway (Etapa 3) — chaves de API (nunca commitadas)
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Modelos por modo (JSON de combos "provider/model", em ordem de prioridade)
# execution = modelos sem restrição (usados quando DEVIL_MODE=true)
# judgment  = modelos fixos/restritos (julgamento/investigação)
EXECUTION_MODELS=["groq/llama-3.3-70b-versatile","openrouter/openrouter/auto"]
JUDGMENT_MODELS=["groq/llama-3.1-8b-instant","openai/gpt-4o-mini"]

# Origens CORS permitidas (JSON)
CORS_ORIGINS=["http://localhost:5173"]

# Scanning ativo (Etapa 12) — valores conservadores para os testes offline.
# Os testes de scanning injetam o próprio client (respx); estes valores apenas
# garantem que o build_scan_service() é determinístico quando usado sem mock.
SCAN_RATE_LIMIT=0
SCAN_REQUEST_TIMEOUT=2
SCAN_MAX_PAGES=2
SCAN_MAX_BODY_BYTES=131072
SCAN_RESPECT_ROBOTS=true
